{
  "enabled": true,
  "name": "Create modals directory",
  "description": "Creating modals subdirectory for modal components",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "mkdir -p procurement-fe/src/components/superadmin/modals",
    "timeout": 5
  }
}